# Copy to .env.local. Never commit real values.

# Google AI (Gemini) — the only paid dependency. Server-side only.
GOOGLE_API_KEY=

# Supabase (free tier): auth (email one-time code), Postgres, private storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External actions are SIMULATED by default. Nothing is ever sent to a hospital, CMS or a patient
# unless this is set to "live" AND a real adapter is configured — neither exists in this build.
EXTERNAL_ACTIONS=simulated

# Connectors: "synthetic" adapters ship with the repo. "sandbox" (CMS Blue Button 2.0 sandbox) is a stretch goal.
CLAIMS_CONNECTOR=synthetic
HOSPITAL_CONNECTOR=synthetic
