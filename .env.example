# Copy to .env.local. Never commit real values. Every variable has a safe default for local demo use.

# Google AI (Gemini). Optional: without it the fixture extractor runs and only fixture documents are readable.
GOOGLE_API_KEY=
# fixture | gemini  (default fixture; gemini also requires GOOGLE_API_KEY)
EXTRACTOR=fixture

# The only mode that exists. Any other value makes every send throw.
EXTERNAL_ACTIONS=simulated

# memory | supabase  (default memory; supabase needs the three values below, Phase 6)
STORE=memory
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extra Waive atlas exports on this machine (the committed fixture covers Massachusetts only).
ATLAS_DIR=

# Demo and development switches. In production these throw at startup unless ALLOW_DEMO=1.
DEMO_CONTROLS=1
STAFF_BYPASS=1
ALLOW_DEMO=0
# Force the synthetic Medicare connector to report unavailable (edge case E05).
CLAIMS_FORCE_DOWN=0
